# Server-side (set these in Vercel → Project → Settings → Environment Variables)
NOTION_TOKEN=secret_xxx            # your Notion integration secret
NOTION_WORDS_DATA_SOURCE=3de10ad0-4071-8097-b653-000bbec9ec4a   # 词典 data source
APP_KEY=choose-a-long-passphrase   # the app asks for this once, so only you can use your dictionary

# Client-side (optional)
# VITE_DEMO=1                      # run with sample words, no Notion needed
